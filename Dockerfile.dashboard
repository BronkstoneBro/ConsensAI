# =============================================================================
# ConsensAI Dashboard Dockerfile
# =============================================================================
# Uses UV for fast, secure dependency management with lockfile verification.
# See: https://docs.astral.sh/uv/guides/integration/docker/
# =============================================================================

FROM python:3.14-slim

# Install UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install dependencies first (better layer caching)
# UV will verify hashes from lockfile for supply chain security
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra dashboard

# Copy dashboard code
COPY dashboard/ ./dashboard/

# Install the project itself
RUN uv sync --frozen --no-dev --extra dashboard

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run with UV
CMD ["uv", "run", "streamlit", "run", "dashboard/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
