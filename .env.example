# =============================================================================
# ConsensAI Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file with real credentials to version control
# =============================================================================

# Application
DEBUG=false
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# LLM Providers
# =============================================================================

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# Groq API (free tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default models for consensus (comma-separated)
# DEFAULT_MODELS=ollama/llama3.2,ollama/mistral,groq/llama-3.1-8b-instant

# =============================================================================
# LiteLLM Proxy Authentication (Production)
# =============================================================================
# For secure production deployment, enable LiteLLM proxy authentication.
#
# Generate a secure master key:
#   openssl rand -hex 32
#
# When set, all requests to LiteLLM proxy will require authentication.
# Leave empty or comment out for local development.
# =============================================================================

# LITELLM_MASTER_KEY=sk-your-secure-master-key-here

# =============================================================================
# Consensus Settings
# =============================================================================
CONSENSUS_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/consensai.db

# =============================================================================
# Benchmark
# =============================================================================
BENCHMARK_BATCH_SIZE=10
